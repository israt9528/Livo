# Server Runtime
NODE_ENV=development
PORT=5000

# Database (Configured for Step 2)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/housing_db?schema=public"

# Authentication Secrets
JWT_ACCESS_SECRET="temporary_development_access_secret_min_32_chars_long_xyz"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="temporary_development_refresh_secret_min_32_chars_long_xyz"
JWT_REFRESH_EXPIRES_IN="7d"

# Payment Gateways (Placeholders for Step 15)
PAYMENT_GATEWAY="STRIPE"
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# Client URL (for CORS)
CLIENT_URL="http://localhost:3000"