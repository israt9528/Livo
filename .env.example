# ==============================================================================
# Application & Server Configuration
# ==============================================================================
NODE_ENV=development
PORT=5000
CLIENT_URL="http://localhost:3000"

# ==============================================================================
# Database (PostgreSQL / Prisma)
# ==============================================================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public&sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/housing_db?schema=public"

# ==============================================================================
# Authentication & Cryptography
# ==============================================================================
# Minimum 32-character random string (e.g. generated via `openssl rand -base64 32`)
JWT_ACCESS_SECRET="your_jwt_access_secret_min_32_characters_long"
JWT_ACCESS_EXPIRES_IN="1d"
JWT_REFRESH_SECRET="your_jwt_refresh_secret_min_32_characters_long"
JWT_REFRESH_EXPIRES_IN="7d"

BCRYPT_SALT_ROUNDS=10

# ==============================================================================
# Seed Initial Admin Account
# ==============================================================================
ADMIN_NAME="System Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMeInProduction123!"

# ==============================================================================
# Cloudinary (Media & Image Uploads)
# ==============================================================================
CLOUDINARY_CLOUD_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# ==============================================================================
# Redis Cache & OTP Store
# ==============================================================================
REDIS_USERNAME="default"
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_PASSWORD="your_redis_password_or_leave_empty"

# ==============================================================================
# Email & SMTP (Nodemailer / Transactional Mail)
# ==============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
# 16-character Google App Password (not your personal account password)
SMTP_PASS="your_smtp_app_password"
EMAIL_FROM="Livo <no-reply@housingplatform.com>"

# ==============================================================================
# Payment Gateways (Stripe)
# ==============================================================================
PAYMENT_GATEWAY="STRIPE"
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"